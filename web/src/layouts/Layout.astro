---
import "../styles/global.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/800.css";

export interface Props {
  title: string;
  desc?: string;
  og?: string;
  slug?: string;
}

const { title, desc, og, slug } = Astro.props as Props;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Primary Meta Tags -->
    <title>{title + " | Cyborg"}</title>
    <meta name="title" content="Cyborg" />
    <meta
      name="description"
      content={desc !== null
        ? desc
        : "Official Cyborg Club of IIIT Delhi"}
    />
    <meta
      name="keywords"
      content="Cyborg, Cyborg Club, IIITD, IIIT Delhi, Robotics, AI, ML, Data Science"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content={"https://cyborg.iiitd.edu.in/" + slug !== null ? slug : ""}
    />
    <meta property="og:title" content="Cyborg" />
    <meta
      property="og:description"
      content="Official Cyborg Club of IIIT Delhi"
    />
    <meta property="og:image" content={og !== null ? og : "/hero-img.webp"} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta
      property="twitter:url"
      content={"https://cyborg.iiitd.edu.in/" + slug !== null ? slug : ""}
    />
    <meta property="twitter:title" content="Cyborg" />
    <meta
      property="twitter:description"
      content="Official Cyborg Club of IIIT Delhi"
    />
    <meta
      property="twitter:image"
      content={og !== null ? og : "/hero-img.webp"}
    />

    <!-- Favicon -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="stylesheet" href="https://use.typekit.net/nzg5mjs.css" />
    <link
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
      rel="stylesheet"
    />
    <link rel="icon" type="image/x-icon" href="/logo.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div id="first-load-screen" class="first-load-screen" aria-hidden="true">
      <div class="first-load-inner">
        <img src="/logo.png" alt="Cyborg" class="first-load-logo" />
        <p class="heading first-load-title">Cyborg</p>
        <div class="first-load-bar"><span></span></div>
      </div>
    </div>
    <header class="header">
      <nav class="nav">
        <div class="mx-auto my-5 max-w-xl container">
          <div class="flex justify-between items-center px-4 md:px-8 xl:px-0">
            <div class="flex items-center">
              <a href="/">
                <img src="/logo.png" alt="logo" class="h-12" />
              </a>
            </div>
            <div class="flex items-center">
              <a href="/events/" class="heading2 px-4 py-2">events</a>
              <a href="/blogs/" class="heading2 px-4 py-2">blog</a>
              <a href="/members/" class="heading2 pl-4 py-2">team</a>
              <button
                id="theme-toggle"
                type="button"
                class="theme-toggle ml-3"
                aria-label="Toggle color theme"
                title="Toggle color theme"
              >
                <i class="material-icons theme-icon" aria-hidden="true"
                  >dark_mode</i
                >
              </button>
            </div>
          </div>
        </div>
      </nav>
    </header>
    <main>
      <slot />
      <!-- contact -->
      <section id="contact" class="footer-bg">
        <div class="container w-11/12 mx-auto">
          <div
            class="mx-auto flex flex-col md:flex-row gap-10 py-20 justify-around max-w-lg md:max-w-none w-4/5 space-y-5 footer-cta"
          >
            <a
              href="./members#alumni"
              class="memAlum flex flex-col p-7 justify-end items-end text-right rounded-xl"
            >
              <h1 class="heading text-3xl font-bold">Our Team and Alumni</h1>

              <div
                class="rounded-full border-1 py-2 px-2 flex justify-center items-center mt-7"
                style="background: #f8f8f870"
              >
                <i class="material-icons footer-cta-icon"> keyboard_arrow_right</i>
              </div>
            </a>
            <div class="flex flex-col justify-center md:w-1/2">
              <h1
                class="fancyJoin heading text-4xl md:text-4xl font-bold leading-10"
              >
                Join Us.
              </h1>

              <h2
                class="heading text-2xl md:text-3xl xl:text-4xl font-bold w-full md:w-4/5 mt-3"
              >
                Become a part of the future of technology.
              </h2>

              <h3 class="font-bold mt-6 mb-2">Perks</h3>
              <ul class="text-gray-500">
                <li class="my-2">
                  Hands-on experience with robotics and AI projects.
                </li>
                <li class="my-2">
                  Access to workshops, hackathons, and tech talks.
                </li>
                <li class="my-2">
                  Connect with industry experts and research opportunities.
                </li>
              </ul>

              <a
                href="https://forms.gle/5xoKNbj6moQpRn2o9"
                class="heading2 applyBtn bg-white px-10 py-2 text-black rounded-lg mt-10 w-1/4 text-center min-w-[128px]"
              >
                apply
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>
    <footer class="px-8 site-footer">
      <div class="container mx-auto py-14 mb-28">
        <div
          class="flex flex-col md:flex-row gap-4 md:gap-8 md:justify-between md:mx-auto space-y-5 mx-auto max-w-lg md:max-w-none footer-shell"
        >
          <div class="flex flex-row gap-4 w-full min-w-fit md:w-1/4 md:mx-auto">
            <div class="flex pt-4">
              <img src="/logowhite.png" alt="logo" class="footerLogo" />
            </div>
            <div class="flex flex-col md:justify-center">
              <h1 class="heading text-xl font-bold">CYBORG</h1>
              <h1 class="heading text-xl font-bold">IIIT Delhi</h1>
              <h2 class="heading text-md font-bold footer-muted">
                robotics & ai club
              </h2>

              <p class="text-sm footer-muted mt-3">
                IIIT Delhi, Okhla Industrial, <br />
                Phase-III, New Delhi-110020
              </p>
            </div>
          </div>
          <div
            class="flex flex-col md:flex-row gap-4 md:gap-16 md:justify-between w-full md:w-1/3 md:mx-auto"
          >
            <div class="flex flex-col w-full md:w-1/2 mb-5 md:mb-5">
              <h1 class="heading font-bold">Affiliations</h1>
              <div
                class="flex flex-wrap gap-1 md:flex-col space-x-5 md:space-x-0"
              >
                <a
                  href="https://iiitd.ac.in/"
                  target="_blank"
                  class="footer-muted"
                  ><span class="link link-underline link-underline-black"
                    >IIIT Delhi
                  </span>
                </a>
              </div>
            </div>
            <div class="flex flex-col w-full md:w-1/2">
              <h1 class="heading font-bold">Socials</h1>
              <div class="flex flex-wrap md:flex-col md:space-x-0 gap-1">
                <a
                  href="https://www.instagram.com/cyborg_iiitd/"
                  target="_blank"
                  class="pr-5 md:pr-0 footer-muted"
                  ><span class="link link-underline link-underline-black"
                    >Instagram
                  </span>
                </a>
                <a
                  href="https://www.facebook.com/cyborgiiitd/"
                  target="_blank"
                  class="pr-5 md:pr-0 footer-muted"
                  ><span class="link link-underline link-underline-black"
                    >Facebook
                  </span>
                </a>
                <a
                  href="https://www.linkedin.com/company/cyborg-iiitd/"
                  target="_blank"
                  class="pr-5 md:pr-0 footer-muted"
                  ><span class="link link-underline link-underline-black"
                    >LinkedIn
                  </span>
                </a>
                <a
                  href="https://www.youtube.com/@cyborgiiitd"
                  target="_blank"
                  class="pr-5 md:pr-0 footer-muted"
                  ><span class="link link-underline link-underline-black"
                    >YouTube
                  </span>
                </a>
                <a
                  href="https://twitter.com/cyborg_iiitd"
                  target="_blank"
                  class="pr-5 md:pr-0 footer-muted"
                  ><span class="link link-underline link-underline-black"
                    >Twitter
                  </span>
                </a>
              </div>
            </div>
          </div>
          <div class="flex flex-col w-full md:w-1/5">
            <h1 class="heading font-bold">Contact</h1>
            <p class="footer-muted">
              <a href="mailto:cyborg@iiitd.ac.in">cyborg@iiitd.ac.in</a>
            </p>

            <h1 class="heading font-bold mt-3">Faculty</h1>
            <p class="footer-muted text-sm">
              Chanekar Prasad Vilas<br/>
              Sayan Basu Roy<br/>
              Sanat Kumar Biswas
            </p>
          </div>
        </div>
      </div>
      <hr class="border-gray-600 opacity-50 rounded-full mx-auto linejoin" />
      <p class="text-center py-3 pb-5 text-gray-600 opacity-50 heading2">
        © 2026 | Cyborg - IIIT Delhi
      </p>
    </footer>
    <script is:inline>
      (() => {
        const storageKey = "cyborg-theme";
        const firstLoadKey = "cyborg-first-load-complete";
        const root = document.documentElement;
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        const loader = document.getElementById("first-load-screen");

        const applyTheme = (theme) => {
          root.setAttribute("data-theme", theme);
          const icon = document.querySelector("#theme-toggle .theme-icon");
          if (icon) {
            icon.textContent = theme === "dark" ? "light_mode" : "dark_mode";
          }
        };

        const hideLoader = () => {
          if (!loader) return;
          loader.classList.add("first-load-screen--hidden");
          window.setTimeout(() => loader.remove(), 450);
        };

        const storedTheme = localStorage.getItem(storageKey);
        applyTheme(storedTheme || (media.matches ? "dark" : "light"));

        document.addEventListener("click", (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const button = target.closest("#theme-toggle");
          if (!button) return;

          const current = root.getAttribute("data-theme");
          const next = current === "dark" ? "light" : "dark";
          localStorage.setItem(storageKey, next);
          applyTheme(next);
        });

        const handleSystemTheme = (event) => {
          if (!localStorage.getItem(storageKey)) {
            applyTheme(event.matches ? "dark" : "light");
          }
        };

        if (typeof media.addEventListener === "function") {
          media.addEventListener("change", handleSystemTheme);
        } else if (typeof media.addListener === "function") {
          media.addListener(handleSystemTheme);
        }

        if (!localStorage.getItem(firstLoadKey)) {
          root.classList.add("first-load-active");
          window.setTimeout(() => {
            hideLoader();
            root.classList.remove("first-load-active");
            localStorage.setItem(firstLoadKey, "1");
          }, 1050);
        } else {
          hideLoader();
        }
      })();
    </script>
    <style is:global>
      * {
        font-family: "Inter", sans-serif;
        font-weight: 400;
      }

      :root {
        color-scheme: light;
        --page-bg: #fff8db;
        --page-spot: rgba(243, 202, 90, 0.22);
        --text-main: #4f3611;
        --text-muted: #7d6440;
        --surface-soft: #fff0b8;
        --surface-strong: #ffe39a;
        --surface-footer: #f3d275;
        --surface-footer-deep: #7a5517;
        --footer-bg-fixed: #f3d275;
        --footer-bg-deep-fixed: #5c3d0d;
        --footer-heading-fixed: #4f3611;
        --footer-muted-fixed: #7a5a25;
        --header-bg: rgba(255, 255, 255, 0.92);
        --header-border: rgba(122, 85, 23, 0.1);
        --card-bg: #fffaf0;
        --card-border: rgba(122, 85, 23, 0.12);
        --card-shadow: 0px 12px 28px -16px rgba(122, 85, 23, 0.28);
        --pattern-tint: rgba(235, 186, 59, 0.2);
        --heading-primary: #4f3611;
        --heading-secondary: #8a641f;
        --fancy-join-a: #e7b84f;
        --fancy-join-b: #f4d97d;
        --fancy-event-a: #d79b1e;
        --fancy-event-b: #f0c75c;
        --fancy-members-a: #a56a14;
        --fancy-members-b: #edc04a;
        --members-heading-page: #8a641f;
        --blog-heading-page: #b17a1b;
        --members-gradient-a: rgba(243, 202, 90, 0.26);
        --members-gradient-b: rgba(255, 236, 170, 0.28);
        --members-gradient-c: rgba(214, 152, 34, 0.16);
        --blog-gradient-a: rgba(243, 202, 90, 0.24);
        --blog-gradient-b: rgba(255, 224, 127, 0.2);
        --blog-gradient-c: rgba(214, 152, 34, 0.15);
        --page-pattern-color: rgba(214, 152, 34, 0.1);
      }

      :root[data-theme="dark"] {
        color-scheme: dark;
        --page-bg: #2f220d;
        --page-spot: rgba(240, 199, 92, 0.18);
        --text-main: #f8e5a4;
        --text-muted: #d3bc7a;
        --surface-soft: #443015;
        --surface-strong: #5a3f1a;
        --surface-footer: #3b280f;
        --surface-footer-deep: #261907;
        --header-bg: rgba(47, 34, 13, 0.8);
        --header-border: rgba(248, 229, 164, 0.12);
        --card-bg: #443015;
        --card-border: rgba(248, 229, 164, 0.12);
        --card-shadow: 0px 12px 30px -16px rgba(0, 0, 0, 0.82);
        --pattern-tint: rgba(240, 199, 92, 0.2);
        --heading-primary: #f8e5a4;
        --heading-secondary: #e3c46d;
        --fancy-join-a: #f0c75c;
        --fancy-join-b: #f7dea0;
        --fancy-event-a: #efc04a;
        --fancy-event-b: #f7dea0;
        --fancy-members-a: #f0c75c;
        --fancy-members-b: #d79b1e;
        --members-heading-page: #f0c75c;
        --blog-heading-page: #f0c75c;
        --members-gradient-a: rgba(240, 199, 92, 0.2);
        --members-gradient-b: rgba(247, 222, 160, 0.16);
        --members-gradient-c: rgba(215, 155, 30, 0.12);
        --blog-gradient-a: rgba(240, 199, 92, 0.2);
        --blog-gradient-b: rgba(247, 222, 160, 0.14);
        --blog-gradient-c: rgba(215, 155, 30, 0.12);
        --page-pattern-color: rgba(240, 199, 92, 0.12);
      }

      :root.first-load-active,
      :root.first-load-active body {
        overflow: hidden;
      }

      body {
        background-color: var(--page-bg);
        background-image:
          radial-gradient(circle at 12% 8%, var(--page-spot) 0, transparent 34%),
          radial-gradient(circle at 88% 0, var(--page-spot) 0, transparent 32%);
        color: var(--text-main);
        transition:
          background-color 0.25s ease,
          color 0.25s ease;
      }

      main {
        color: var(--text-main);
      }

      .page-gradient {
        position: relative;
        isolation: isolate;
        overflow: clip;
      }

      .page-gradient::before,
      .page-gradient::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
      }

      .page-gradient::before {
        z-index: 0;
        background-size: 150% 150%;
        animation: pageGradientFloat 16s ease-in-out infinite alternate;
      }

      .page-gradient::after {
        z-index: 0;
        background-image:
          repeating-linear-gradient(
            120deg,
            transparent 0,
            transparent 14px,
            var(--page-pattern-color) 14px,
            var(--page-pattern-color) 15px
          ),
          repeating-linear-gradient(
            -120deg,
            transparent 0,
            transparent 18px,
            var(--page-pattern-color) 18px,
            var(--page-pattern-color) 19px
          );
        opacity: 0.5;
        animation: pagePatternFlow 22s linear infinite;
      }

      .page-gradient > * {
        position: relative;
        z-index: 1;
      }

      .page-gradient-members::before {
        background-image:
          radial-gradient(
            62% 54% at 14% 18%,
            var(--members-gradient-a) 0,
            transparent 72%
          ),
          radial-gradient(
            52% 45% at 88% 20%,
            var(--members-gradient-b) 0,
            transparent 70%
          ),
          radial-gradient(
            58% 52% at 48% 92%,
            var(--members-gradient-c) 0,
            transparent 70%
          );
      }

      .page-gradient-blog::before {
        background-image:
          radial-gradient(
            60% 52% at 10% 16%,
            var(--blog-gradient-a) 0,
            transparent 70%
          ),
          radial-gradient(
            54% 48% at 84% 26%,
            var(--blog-gradient-b) 0,
            transparent 72%
          ),
          radial-gradient(
            66% 54% at 52% 92%,
            var(--blog-gradient-c) 0,
            transparent 72%
          );
      }

      .heading.page-heading-members,
      .heading.page-heading-blog {
        background: none;
        -webkit-text-fill-color: currentColor;
      }

      .heading.page-heading-members {
        color: var(--members-heading-page);
      }

      .heading.page-heading-blog {
        color: var(--blog-heading-page);
      }

      @keyframes pageGradientFloat {
        0% {
          transform: translate3d(-2%, -1.5%, 0) scale(1);
        }
        100% {
          transform: translate3d(2%, 2%, 0) scale(1.06);
        }
      }

      @keyframes pagePatternFlow {
        from {
          background-position: 0 0, 0 0;
        }
        to {
          background-position: 300px 200px, -240px 220px;
        }
      }

      .theme-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.35rem;
        height: 2.35rem;
        border-radius: 999px;
        border: 1px solid var(--card-border);
        background: var(--card-bg);
        color: var(--text-main);
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease,
          border-color 0.2s ease;
      }

      .theme-toggle:hover {
        transform: translateY(-1px);
        box-shadow: var(--card-shadow);
      }

      .theme-icon {
        font-size: 1.15rem;
        line-height: 1;
      }

      .first-load-screen {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: grid;
        place-items: center;
        background:
          radial-gradient(circle at 25% 15%, var(--page-spot), transparent 40%),
          var(--page-bg);
        transition:
          opacity 0.35s ease,
          visibility 0.35s ease;
      }

      .first-load-screen--hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      .first-load-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.85rem;
      }

      .first-load-logo {
        width: 84px;
        height: 84px;
        border-radius: 1rem;
        box-shadow: var(--card-shadow);
      }

      .first-load-title {
        font-size: 1.3rem;
        color: var(--heading-primary);
      }

      .first-load-bar {
        width: 136px;
        height: 4px;
        background: color-mix(in srgb, var(--heading-secondary) 18%, transparent);
        border-radius: 999px;
        overflow: hidden;
      }

      .first-load-bar span {
        display: block;
        width: 52%;
        height: 100%;
        background: linear-gradient(
          90deg,
          var(--fancy-event-a),
          var(--fancy-event-b)
        );
        border-radius: 999px;
        animation: firstLoadPulse 0.95s ease-in-out infinite alternate;
      }

      @keyframes firstLoadPulse {
        from {
          transform: translateX(-8px);
          opacity: 0.78;
        }
        to {
          transform: translateX(74px);
          opacity: 1;
        }
      }

      .lift-card {
        transition:
          transform 0.28s ease,
          box-shadow 0.28s ease,
          border-color 0.28s ease;
      }

      .lift-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--card-shadow);
      }

      .card-pattern {
        position: relative;
        overflow: hidden;
        isolation: isolate;
      }

      .card-pattern::after {
        content: "";
        position: absolute;
        inset: 0;
        background-image: repeating-linear-gradient(
          135deg,
          var(--pattern-tint) 0,
          var(--pattern-tint) 2px,
          transparent 2px,
          transparent 12px
        );
        opacity: 0.06;
        pointer-events: none;
      }

      .card-pattern > * {
        position: relative;
        z-index: 1;
      }

      main section {
        animation: sectionReveal 0.55s ease both;
      }

      main section:nth-of-type(2) {
        animation-delay: 0.04s;
      }

      main section:nth-of-type(3) {
        animation-delay: 0.08s;
      }

      @keyframes sectionReveal {
        from {
          opacity: 0;
          transform: translateY(8px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .margin-space {
        margin-left: 12.5rem;
        margin-right: 12.5rem;
      }

      .container {
        width: 100%;
        max-width: 1200px;
      }

      .header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        /* height: 6.5rem; */
        background-color: var(--header-bg);
        -webkit-backdrop-filter: blur(8px);
        backdrop-filter: blur(50px);
        z-index: 10;
      }

      .heading,
      .heading2 {
        font-family: Sofia-pro, sans-serif;
        font-weight: 900;
        font-style: normal;
        color: var(--heading-primary);
      }

      .heading2 {
        font-weight: 400;
        color: var(--heading-secondary);
      }

      .header a.heading2 {
        color: var(--heading-secondary);
      }

      .heroImg {
        width: 100%;
        height: 100%;
        max-width: 633.12px;
        max-height: 633px;
      }

      .aboutCont {
        height: 50vh;
      }

      .fancyBtn {
        background-image: linear-gradient(
          to right,
          #d79b1e,
          #efc04a,
          #f4d97d,
          #e7b84f
        );
        box-shadow: 0 8px 18px 0 rgba(183, 126, 22, 0.32);
        background-size: 300% 100%;

        moz-transition:
          background 0.4s ease-in-out,
          box-shadow 0.4s ease-in-out;
        -o-transition:
          background 0.4s ease-in-out,
          box-shadow 0.4s ease-in-out;
        -webkit-transition:
          background 0.4s ease-in-out,
          box-shadow 0.4s ease-in-out;
        transition:
          background 0.4s ease-in-out,
          box-shadow 0.4s ease-in-out;
      }

      .fancyBtn:hover {
        background-position: 100% 0;
        box-shadow: 0 8px 20px 2px rgba(183, 126, 22, 0.38);

        moz-transition:
          background 0.4s ease-in-out,
          box-shadow 0.4s ease-in-out;
        -o-transition:
          background 0.4s ease-in-out,
          box-shadow 0.4s ease-in-out;
