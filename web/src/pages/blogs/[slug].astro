---
import Layout from "../../layouts/Layout.astro";
import { escapeHTML, toHTML, uriLooksSafe } from "@portabletext/to-html";
import { allPosts } from "../../lib/api";
import { formatBlogPostDate, getSanityContent } from "../../utils/helpers";

export interface Blog {
    title: string;
    desc: string;
    slug: {
        current: string;
    };
    BlogedDate: string;
    author: {
        fName: string;
        lName: string;
        position: string;
        photo: {
            asset: {
                url: string;
            };
            alt: string;
        } | null;
    };
    coverImg: {
        asset: {
            url: string;
        };
        alt: string;
        caption: string;
    };
    category: {
        categoryName: string;
    };
    contentRaw: any[];
    tags?: {
        tagName: string;
    }[];
}

export async function getStaticPaths() {
    const response = await getSanityContent({ query: allPosts });
    const blogData: Blog[] = response.allBlog;
    return blogData.map((blog) => ({
        params: { slug: blog.slug.current },
        props: { blog },
    }));
}

const { blog } = Astro.props as { blog: Blog };

const sanityProjectId = import.meta.env.PUBLIC_SANITY_PROJECT_ID || "zakv95rn";
const sanityDataset = import.meta.env.PUBLIC_SANITY_DATASET || "production";

const getSanityAssetUrl = (assetRef?: string) => {
    if (!assetRef || typeof assetRef !== "string" || !assetRef.startsWith("image-")) {
        return "";
    }

    const [, id, dimensions, format] = assetRef.split("-");
    if (!id || !dimensions || !format) {
        return "";
    }

    return `https://cdn.sanity.io/images/${sanityProjectId}/${sanityDataset}/${id}-${dimensions}.${format}`;
};

const renderPortableImage = (value: any, className = "blog-inline-image") => {
    const src = value?.asset?.url || getSanityAssetUrl(value?.asset?._ref);
    if (!src) {
        return "";
    }

    const alt = escapeHTML(value?.alt || "");
    const caption = value?.caption
        ? `<figcaption>${escapeHTML(value.caption)}</figcaption>`
        : "";

    return `<figure class="${className}"><img src="${escapeHTML(src)}" alt="${alt}" loading="lazy" decoding="async" />${caption}</figure>`;
};

const safeFormatDate = (dateValue?: string) => {
    if (!dateValue) {
        return "";
    }

    try {
        return formatBlogPostDate(dateValue);
    } catch {
        return "";
    }
};

const renderEventReport = (value: any) => {
    const eventName = escapeHTML(value?.eventName || "Event report");
    const posterHtml = renderPortableImage(value?.eventPoster, "event-report-poster");
    const eventDate = safeFormatDate(value?.eventDate);
    const prizeAmount =
        typeof value?.prizes === "number" ? `INR ${value.prizes.toLocaleString("en-IN")}` : "";
    const description = value?.desc
        ? `<p class="event-report-desc">${escapeHTML(value.desc)}</p>`
        : "";

    const winners = Array.isArray(value?.winners) ? value.winners : [];
    const winnersHtml =
        winners.length > 0
            ? `<ul class="event-report-winners">${winners
                  .map((winner: any) => {
                      const names = Array.isArray(winner?.names)
                          ? winner.names.map((name: string) => escapeHTML(name)).join(", ")
                          : "";
                      const position = Number.isFinite(Number(winner?.position))
                          ? `${Number(winner.position)}.`
                          : "-";
                      return `<li><span>${position}</span><span>${names}</span></li>`;
                  })
                  .join("")}</ul>`
            : "";

    const morePhotos =
        typeof value?.morePhotos === "string" && uriLooksSafe(value.morePhotos)
            ? `<a href="${escapeHTML(value.morePhotos)}" target="_blank" rel="noopener noreferrer" class="event-report-link">More photos</a>`
            : "";

    const metaBits = [eventDate, prizeAmount].filter(Boolean);
    const metadata =
        metaBits.length > 0
            ? `<p class="event-report-meta">${metaBits.map((item) => escapeHTML(item)).join(" • ")}</p>`
            : "";

    return `<section class="event-report-card">${posterHtml}<div class="event-report-content"><h3>${eventName}</h3>${metadata}${description}${winnersHtml}${morePhotos}</div></section>`;
};

const title = blog?.title || "Blog";
const authorFName = blog?.author?.fName || "";
const authorLName = blog?.author?.lName || "";
const authorName = `${authorFName} ${authorLName}`.trim() || "Cyborg IIIT Delhi";
const authorPhotoSrc = blog?.author?.photo?.asset?.url || "/people/avatar.png";
const authorPhotoAlt = blog?.author?.photo?.alt || authorName;
const tags = Array.isArray(blog?.tags) ? blog.tags : [];
const bodyHtml = toHTML(blog?.contentRaw || [], {
    components: {
        types: {
            img: ({ value }) => renderPortableImage(value),
            eventReport: ({ value }) => renderEventReport(value),
        },
    },
});
---

<Layout
    title={title}
    og={blog?.coverImg?.asset?.url || "/hero-img.webp"}
    desc={blog?.desc || ""}
    slug={blog?.slug?.current || "blogs"}
>
    <section class="page-gradient page-gradient-blog md:min-h-screen">
        <div class="container mx-auto">
            <div class="flex flex-col gap-x-28 pt-28 pb-24 md:pt-28 md:pb-24">
                <div class="w-5/6 mx-auto">
                    <p class="cursor-pointer opacity-75 font-medium">
                        <a class="font-medium" href="/blogs">blog</a> / {title}
                    </p>
                    <div
                        class="flex flex-col gap-8 md:flex-row md:gap-0 justify-between w-full mt-10"
                    >
                        <h2 class="text-5xl font-bold md:max-w-[80%]">{title}</h2>
                        <div class="flex gap-3">
                            <img
                                src={authorPhotoSrc}
                                alt={authorPhotoAlt}
                                class="rounded-full w-10 h-10 object-cover"
                            />
                            <div>
                                <p class="font-semibold opacity-50">{authorName}</p>
                                <p class="opacity-50 text-xs font-medium">
                                    {blog?.author?.position || ""}
                                </p>
                            </div>
                        </div>
                    </div>

                    {
                        blog?.coverImg?.asset?.url && (
                            <img
                                src={blog.coverImg.asset.url}
                                alt={blog.coverImg.alt}
                                class="w-full rounded-2xl my-8"
                            />
                        )
                    }

                    {
                        blog?.BlogedDate && (
                            <p class="opacity-75 text-3xl font-medium">
                                {formatBlogPostDate(blog.BlogedDate)}
                            </p>
                        )
                    }

                    <div class="my-8 mb-16" set:html={bodyHtml}></div>

                    {
                        tags.length > 0 && (
                            <p>
                                {tags.map((tag) => (
                                    <span class="py-1 px-2 mr-4 bg-gray-200">
                                        {tag.tagName}
                                    </span>
                                ))}
                            </p>
                        )
                    }
                </div>
            </div>
        </div>
    </section>
</Layout>

<style>
    .blog-inline-image {
        margin: 2rem auto;
        width: min(100%, 840px);
    }

    .blog-inline-image img {
        width: 100%;
        border-radius: 0.9rem;
    }

    .blog-inline-image figcaption {
        font-size: 0.9rem;
        opacity: 0.75;
        margin-top: 0.65rem;
        text-align: center;
    }

    .event-report-card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 1rem;
        padding: 1.15rem;
        margin: 2rem 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        box-shadow: var(--card-shadow);
    }

    .event-report-poster {
        margin: 0;
        width: 100%;
    }

    .event-report-poster img {
        width: 100%;
        border-radius: 0.8rem;
    }

    .event-report-content h3 {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
    }

    .event-report-meta {
        opacity: 0.8;
        margin-top: 0.35rem;
        margin-bottom: 0.65rem;
    }

    .event-report-desc {
        opacity: 0.9;
        line-height: 1.65;
    }

    .event-report-winners {
        margin: 0.85rem 0;
        display: grid;
        gap: 0.45rem;
        list-style: none;
        padding: 0;
    }

    .event-report-winners li {
        display: grid;
        grid-template-columns: 2.5rem 1fr;
        gap: 0.35rem;
    }

    .event-report-link {
        display: inline-flex;
        margin-top: 0.55rem;
        color: var(--fancy-event-a);
        text-decoration: underline;
        text-underline-offset: 0.2rem;
    }

    @media (min-width: 768px) {
        .event-report-card {
            padding: 1.4rem;
            flex-direction: row;
            gap: 1.35rem;
        }

        .event-report-poster {
            width: 280px;
            flex-shrink: 0;
        }
    }
</style>
